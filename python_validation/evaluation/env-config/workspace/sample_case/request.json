{
  "action": "full_config_client",
  "config": {
    "api_key": "  abcd1234-secret  ",
    "timeout": 45,
    "max_retries": 2,
    "base_url": "https://api.example.test",
    "validation_mode": "warn",
    "unknown_param_policy": "warn",
    "rate_limit": {"daily_limit": 500, "requests_per_minute": 900},
    "logging": {
      "level": "DEBUG",
      "handlers": {"console": {"level": "INFO"}},
      "log_path": null
    },
    "cache": {"backend": "redis", "default_ttl": 120, "redis_url": "redis://cache"},
    "embedding_provider": "beta",
    "embedding_model": "embed-small",
    "embedding_api_key": "beta-key-123",
    "vector_store_path": "/tmp/vector-store",
    "similarity_threshold": 0.75,
    "max_tools": 8,
    "embedding_config": {"kwargs": {"batch": 2}}
  }
}
